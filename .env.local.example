# Supabase（必須）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# GROQ（必須 - サーバーサイドのみ。日記生成・書き直し・分析・週次レポートに使用）
GROQ_API_KEY=gsk_...

# 使用モデルの上書き（任意）。未設定なら日本語に強い既定モデルを使用
# GROQ_MODEL_QUALITY=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# 音声入力の文字起こしモデル。既定は高速・低コストの turbo。精度優先なら whisper-large-v3 に
# GROQ_MODEL_TRANSCRIBE=whisper-large-v3-turbo

# シークレット暗号化キー（推奨 - Notionトークン等をDBに保存する際の暗号化に使用）
# ランダムな長い文字列を設定: openssl rand -base64 32 などで生成
ENCRYPTION_KEY=

# Notion（任意 - アプリの設定画面からでも入力できます）
NOTION_API_KEY=secret_...
NOTION_DATABASE_ID=your-database-id

# Google Calendar（任意 - サーバーサイドのみ）
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Web Push（任意 - 毎日のリマインダー通知に必要）
# キー生成: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 通知配信 cron の認証（ランダム文字列。Vercel が cron 呼び出し時に自動で付与する）
CRON_SECRET=

# 通知配信で全ユーザーの購読を読むためのキー（Supabase → Project Settings → API → service_role）
# ⚠️ サーバー専用。絶対に NEXT_PUBLIC_ を付けない
SUPABASE_SERVICE_ROLE_KEY=
